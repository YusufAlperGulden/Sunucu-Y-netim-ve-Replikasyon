
                    <!-- Cloud Storage Content -->
                    <div id="settings-content-cloud" class="settings-content-pane" style="display: none; padding: 24px; flex-direction: column;">
                        <div style="display: flex; justify-content: flex-end; margin-bottom: 24px;">
                            <button style="background: #3a1c94; color: white; border: none; border-radius: 4px; padding: 8px 16px; font-size: 0.9rem; cursor: pointer; display: flex; align-items: center; gap: 8px;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg> Add cloud storage credentials
                            </button>
                        </div>
                        <div style="background: #f9fafb; display: grid; grid-template-columns: 80px 1fr 1fr 2fr; padding: 12px 16px; font-weight: 600; font-size: 0.85rem; color: #4b5563; border-bottom: 1px solid #e5e7eb;">
                            <div>ID</div><div>Name</div><div>Provider</div><div>Comment</div>
                        </div>
                        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60px 0; color: #6b7280; font-size: 0.9rem;">
                            <svg width="64" height="64" viewBox="0 0 24 24" fill="#e5e7eb" stroke="#d1d5db" stroke-width="1" style="margin-bottom: 16px;"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                            You haven't created credentials yet. When you do, it'll show up here.
                        </div>
                    </div>

                    <!-- Notification Services Content -->
                    <div id="settings-content-notifications" class="settings-content-pane" style="display: none; padding: 24px; flex-direction: column;">
                        <div style="display: flex; justify-content: flex-end; margin-bottom: 24px;">
                            <button style="background: #3a1c94; color: white; border: none; border-radius: 4px; padding: 8px 16px; font-size: 0.9rem; cursor: pointer; display: flex; align-items: center; gap: 8px;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg> Add new integration
                            </button>
                        </div>
                        <div style="background: #f9fafb; display: grid; grid-template-columns: 1.5fr 1fr 1fr 1.5fr 1fr; padding: 12px 16px; font-weight: 600; font-size: 0.85rem; color: #4b5563; border-bottom: 1px solid #e5e7eb;">
                            <div>Name</div><div>Service</div><div>Active</div><div>Send Alarms From</div><div>Trigger events</div>
                        </div>
                        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60px 0; color: #6b7280; font-size: 0.9rem;">
                            <svg width="64" height="64" viewBox="0 0 24 24" fill="#e5e7eb" stroke="#d1d5db" stroke-width="1" style="margin-bottom: 16px;"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                            You haven't created integration
                        </div>
                    </div>
